if $# > 0 then
# replacement for getastrom_astrometrydotnet that uses LE1 header info
# to predict the WCS for the thumbnail
foreach p ($*)
 set pp = `echo $p|sed 's/.png//'`
 if ! -e {$pp}.nowcs then  # dont process failed earlier attempts
  if ! -e {$pp}.wcs then   # dont process existing solved case
   p3 $scr/mkthumbwcs.py $pp.fits
  endif
 endif
end
endif


